<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>UpKeep_UiTests</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>false</EnableMsixTooling>
    <EnableWinAppRunSupport>false</EnableWinAppRunSupport>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <ApplicationManifest>../../src/UpKeep.App/app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Microsoft.WindowsPackageManager.ComInterop" Version="1.29.380" />
    <ProjectReference Include="../../src/UpKeep.Core/UpKeep.Core.csproj" />
    <Compile Include="../../src/UpKeep.App/MainWindow*.cs" Link="%(Filename)%(Extension)" />
    <Compile Include="../../src/UpKeep.App/CleanupText.cs" Link="CleanupText.cs" />
    <Compile Include="../../src/UpKeep.App/Platform/*.cs" Link="Platform/%(Filename)%(Extension)" />
    <Compile Include="../UpKeep.Tests/Scratch.cs" Link="Scratch.cs" />
    <Page Include="../../src/UpKeep.App/MainWindow.xaml" Link="MainWindow.xaml" />
    <Content Include="../../src/UpKeep.App/Assets/AppIcon.ico" Link="Assets/AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
