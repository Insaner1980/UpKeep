<Window x:Class="UpKeep_App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UpKeep">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="OnKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Padding="20,12,12,8" ColumnSpacing="8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border Width="28" Height="28" CornerRadius="6" Background="{ThemeResource AccentFillColorDefaultBrush}">
    <FontIcon Glyph="&#xE70E;" FontSize="18" Foreground="White"/>
   </Border>
   <TextBlock Grid.Column="1" Text="UpKeep" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
   <Button Grid.Column="2" Click="OnSettings" AutomationProperties.Name="Settings" ToolTipService.ToolTip="Settings" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE713;" FontSize="16"/></Button>
   <Button Grid.Column="3" Click="OnHide" AutomationProperties.Name="Hide UpKeep" ToolTipService.ToolTip="Hide UpKeep" Style="{StaticResource SubtleButtonStyle}"><FontIcon Glyph="&#xE711;" FontSize="16"/></Button>
  </Grid>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Top" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsPaneToggleButtonVisible="False" SelectionChanged="OnTabChanged">
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="UpdatesTab" Content="Updates" Tag="updates" IsSelected="True"/>
    <NavigationViewItem Content="Cleanup" Tag="cleanup"/>
   </NavigationView.MenuItems>
   <Grid>
    <Grid x:Name="UpdatesPanel">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="20,16,20,8" Spacing="8">
      <TextBlock x:Name="UpdateSummary" Text="Check your installed tools for updates." TextWrapping="Wrap" FontSize="16"/>
      <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" IsIndeterminate="False" AutomationProperties.Name="Update activity"/>
      <TextBlock x:Name="UpdateStage" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
      <CheckBox x:Name="SelectUpdates" Content="Select all updates" Visibility="Collapsed"/>
     </StackPanel>
     <ListView x:Name="UpdateList" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch"/>
     <Grid Grid.Row="2" Padding="20,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="CheckButton" Content="Check for updates" HorizontalAlignment="Stretch" IsEnabled="False"/>
      <Button x:Name="UpdateButton" Grid.Column="1" Content="Update selected" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
     </Grid>
    </Grid>
    <Grid x:Name="CleanupPanel" Visibility="Collapsed">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="CleanupSummary" Text="Analyze first to find items you can clean." Margin="20,16,20,8" FontSize="16" TextWrapping="Wrap"/>
     <ListView x:Name="CleanupList" Grid.Row="1" SelectionMode="None" HorizontalContentAlignment="Stretch"/>
     <TextBlock x:Name="SelectedSize" Grid.Row="2" Text="Analyze to find cleanup candidates." Margin="20,8" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     <Grid Grid.Row="3" Padding="20,12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" ColumnSpacing="8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="AnalyzeButton" Content="Analyze" HorizontalAlignment="Stretch" IsEnabled="False"/>
      <Button x:Name="CleanButton" Grid.Column="1" Content="Clean selected" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" IsEnabled="False"/>
     </Grid>
    </Grid>
   </Grid>
  </NavigationView>
 </Grid>
</Window>
